    <origin xyz="0.03115 0 -0.0075" rpy="0 0 0"/>
    <parent link="FL_hip_link"/>
    <child link="FL_thigh_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.9" upper="0.9" effort="20" velocity="1.57"/>
  </joint>

  <link name="FL_thigh_link">
    <inertial>
      <origin xyz="0.01875 0 0" rpy="0 0 1.57"/>
      <mass value="0.03"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0.01875 0 0" rpy="0 0 1.57"/>
