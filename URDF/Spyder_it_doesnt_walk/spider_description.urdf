<?xml version="1.0"?>
<robot name="spider_robot">

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0625 0.0955 0.0246"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0625 0.0955 0.0246"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== FRONT LEFT LEG ==================== -->
  
  <!-- FL Hip Joint and Link -->
  <joint name="FL_hip_joint" type="revolute">
    <origin xyz="0.03125 0.04100 0.012" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="FL_hip_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="20" velocity="1.57"/>
  </joint>

  <link name="FL_hip_link">
    <inertial>
      <origin xyz="0.01565 0 -0.01755" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0.01565 0 -0.01755" rpy="0 0 0"/>
      <geometry>
        <box size="0.0273 0.012 0.0351"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.6 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.01565 0 -0.01755" rpy="0 0 0"/>
      <geometry>
        <box size="0.0273 0.012 0.0351"/>
      </geometry>
    </collision>
  </link>

  <!-- FL Thigh Joint and Link -->
