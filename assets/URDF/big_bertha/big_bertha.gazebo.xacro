<?xml version="1.0" ?>
<robot name="big_bertha_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin name="gz_ros2_control" filename="libgz_ros2_control.so">
      <ros2_control_config>$(arg ros2_control_config)</ros2_control_config>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <xacro:macro name="gazebo_link_properties" params="link_name">
    <gazebo reference="${link_name}">
      <material>Gazebo/Grey</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>

  <gazebo_link_properties link_name="arm_a_1_1"/>
  <gazebo_link_properties link_name="arm_a_2_1"/>
  <gazebo_link_properties link_name="arm_a_3_1"/>
  <gazebo_link_properties link_name="arm_a_4_1"/>
  <gazebo_link_properties link_name="arm_b_1_1"/>
  <gazebo_link_properties link_name="arm_b_2_1"/>
  <gazebo_link_properties link_name="arm_b_3_1"/>
  <gazebo_link_properties link_name="arm_b_4_1"/>
  <gazebo_link_properties link_name="arm_c_1_1"/>
  <gazebo_link_properties link_name="arm_c_2_1"/>
  <gazebo_link_properties link_name="arm_c_3_1"/>
  <gazebo_link_properties link_name="arm_c_4_1"/>

  <gazebo reference="lidar_link">
    <sensor name="ydlidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <ray>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_lidar.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu</topic>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <imu_gaussian_noise>0.001</imu_gaussian_noise>
        <accel_gaussian_noise>0.001</accel_gaussian_noise>
        <rate_gaussian_noise>0.001</rate_gaussian_noise>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg publish_odom)">
    <gazebo>
      <plugin name="odometry_publisher" filename="libgz_ros2_control.so">
<ros2_control_config>$(arg ros2_control_config)</ros2_control_config>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>