<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Right_leg_2_macro">

  <xacro:macro name="Right_leg_2" params="prefix">

    <!-- Links -->
    <link name="${prefix}right_front_hip_rigid_assembly">
      <inertial>
        <origin xyz="0.000053 -0.042676 0.029327" rpy="0 0 0"/>
        <mass value="0.113331"/>
        <inertia ixx="6.452948e-05" ixy="1.848281e-06" ixz="1.018547e-06"
                 iyy="5.065981e-05" iyz="-1.872914e-06" izz="3.768808e-05"/>
      </inertial>
      <visual>
        <origin xyz="-0.003264 -0.060487 0.026733" rpy="-1.575091 -1.570796 0.000000"/>
        <geometry>
          <mesh filename="package://big_bertha_description/meshes/Right_leg_2/right_front_hip_rigid_assembly.obj" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="MG995_envelope_55g_mass_proxy"/>
      </visual>
      <collision>
        <origin xyz="-0.003264 -0.060487 0.026733" rpy="-1.575091 -1.570796 0.000000"/>
        <geometry>
          <mesh filename="package://big_bertha_description/meshes/Right_leg_2/right_front_hip_rigid_assembly_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}right_front_upper_rigid_assembly">
      <inertial>
        <origin xyz="-0.040002 -0.000100 0.026063" rpy="0 0 0"/>
        <mass value="0.072689"/>
        <inertia ixx="4.139625e-05" ixy="2.658012e-07" ixz="4.570247e-11"
                 iyy="7.984765e-05" iyz="6.611738e-09" izz="4.488209e-05"/>
      </inertial>
      <visual>
        <origin xyz="-0.039999 0.000276 0.026150" rpy="1.563884 -1.570796 0.000000"/>
        <geometry>
          <mesh filename="package://big_bertha_description/meshes/Right_leg_2/right_front_upper_rigid_assembly.obj" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="ABS_solid_baseline_25pct_print_NOT_calibrated"/>
      </visual>
      <collision>
        <origin xyz="-0.039999 0.000276 0.026150" rpy="1.563884 -1.570796 0.000000"/>
        <geometry>
          <mesh filename="package://big_bertha_description/meshes/Right_leg_2/right_front_upper_rigid_assembly_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}right_front_lower_rigid_assembly">
      <inertial>
        <origin xyz="-0.005628 -0.033585 0.021969" rpy="0 0 0"/>
        <mass value="0.131661"/>
        <inertia ixx="2.939172e-04" ixy="-2.729565e-05" ixz="-2.740272e-06"
                 iyy="2.442846e-05" iyz="-2.870266e-06" izz="2.896559e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.010139 -0.012355 0.019496" rpy="1.570796 0.000000 1.559621"/>
        <geometry>
          <mesh filename="package://big_bertha_description/meshes/Right_leg_2/right_front_lower_rigid_assembly.obj" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="MG995_envelope_55g_mass_proxy"/>
      </visual>
      <collision>
        <origin xyz="-0.010139 -0.012355 0.019496" rpy="1.570796 0.000000 1.559621"/>
        <geometry>
          <mesh filename="package://big_bertha_description/meshes/Right_leg_2/right_front_lower_rigid_assembly_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}right_front_hip_pitch" type="revolute">
      <parent link="${prefix}right_front_hip_rigid_assembly"/>
      <child link="${prefix}right_front_upper_rigid_assembly"/>
      <origin xyz="-0.027117 -0.050384 0.039200" rpy="1.570796 0.000000 1.566502"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="-1.134464" upper="1.221730" effort="100.0" velocity="1.00"/>
    </joint>

    <joint name="${prefix}right_front_knee_pitch" type="revolute">
      <parent link="${prefix}right_front_upper_rigid_assembly"/>
      <child link="${prefix}right_front_lower_rigid_assembly"/>
      <origin xyz="-0.079998 0.000553 0.004400" rpy="0.000000 0.000000 0.000000"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="-1.919862" upper="0.523599" effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}Right_leg_2_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/Right_leg_2_system/cmd</param>
        <param name="state_topic">sim/Right_leg_2_system/state</param>
      </hardware>

      <joint name="${prefix}right_front_hip_pitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}right_front_knee_pitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>